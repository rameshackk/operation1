{
  "version": 2,
  "regions": ["bom1"],
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "muthaleetuthisai-rho.vercel.app"
        }
      ],
      "destination": "https://www.muthaleetuthisai.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "muthaleetuthisai.com"
        }
      ],
      "destination": "https://www.muthaleetuthisai.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(js|css|fonts|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/home",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/articles(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/videos(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/publishers(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://apis.google.com https://accounts.google.com https://www.youtube.com https://s.ytimg.com https://www.gstatic.com https://translate.google.com https://translate.googleapis.com; style-src 'self' 'unsafe-inline' https://www.gstatic.com https://fonts.googleapis.com https://translate.googleapis.com; style-src-elem 'self' 'unsafe-inline' https://www.gstatic.com https://fonts.googleapis.com https://translate.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://www.gstatic.com; img-src 'self' data: blob: https: https://i.ytimg.com https://images.unsplash.com https://www.gstatic.com https://translate.googleapis.com; media-src 'self' blob: data: https://*.supabase.co; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://accounts.google.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://accounts.google.com https://www.googleapis.com https://translation.googleapis.com https://texttospeech.googleapis.com https://translate.googleapis.com https://i.ytimg.com https://www.gstatic.com; object-src 'none'; base-uri 'self';"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/fetch-videos",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/fetch-news",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/render"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/api/home",
      "destination": "/api/home"
    },
    {
      "source": "/api/auth/signup",
      "destination": "/api/auth?action=signup"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth"
    },
    {
      "source": "/api/translate",
      "destination": "/api/translate"
    },
    {
      "source": "/api/admin/metrics",
      "destination": "/api/admin/videos?metrics=1"
    },
    {
      "source": "/api/admin/channels",
      "destination": "/api/admin/publishers?type=channels"
    },
    {
      "source": "/api/videos/trending-preview",
      "destination": "/api/videos?preview=1"
    },
    {
      "source": "/api/videos/:id",
      "destination": "/api/videos?id=:id"
    },
    {
      "source": "/api/news/:slug",
      "destination": "/api/articles?slug=:slug"
    },
    {
      "source": "/api/news",
      "destination": "/api/articles?news=1"
    },
    {
      "source": "/api/articles/:slug/comments/:commentId/like",
      "destination": "/api/articles?slug=:slug&action=like_comment&commentId=:commentId"
    },
    {
      "source": "/api/articles/:slug/comments/:commentId",
      "destination": "/api/articles?slug=:slug&action=delete_comment&commentId=:commentId"
    },
    {
      "source": "/api/articles/:slug/comments",
      "destination": "/api/articles?slug=:slug&action=comments"
    },
    {
      "source": "/api/articles/:slug/view",
      "destination": "/api/articles?slug=:slug&action=view"
    },
    {
      "source": "/api/articles/:slug",
      "destination": "/api/articles?slug=:slug"
    },
    {
      "source": "/api/publisher/onboarding",
      "destination": "/api/publishers"
    },
    {
      "source": "/api/publishers/:id",
      "destination": "/api/publishers?id=:id"
    },
    {
      "source": "/api/admin/articles/:id",
      "destination": "/api/admin/articles?id=:id"
    },
    {
      "source": "/api/admin/publishers/:id",
      "destination": "/api/admin/publishers?id=:id"
    },
    {
      "source": "/videos/:slug+",
      "destination": "/api/render"
    },
    {
      "source": "/articles/:slug+",
      "destination": "/api/render"
    },
    {
      "source": "/news/:slug+",
      "destination": "/api/render"
    },
    {
      "source": "/professionals/:id+",
      "destination": "/api/render"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

