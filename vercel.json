{
  "version": 2,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://apis.google.com https://accounts.google.com https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdn.tailwindcss.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: data: https://*.supabase.co; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://accounts.google.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://accounts.google.com https://www.googleapis.com https://translation.googleapis.com https://texttospeech.googleapis.com; object-src 'none'; base-uri 'self';"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/fetch-videos",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/fetch-news",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/render"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/api/auth/signup",
      "destination": "/api/auth?action=signup"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth"
    },
    {
      "source": "/api/translate",
      "destination": "/api/admin/articles?action=translate"
    },
    {
      "source": "/api/admin/metrics",
      "destination": "/api/admin/videos?metrics=1"
    },
    {
      "source": "/api/admin/channels",
      "destination": "/api/admin/publishers?type=channels"
    },
    {
      "source": "/api/videos/trending-preview",
      "destination": "/api/videos?preview=1"
    },
    {
      "source": "/api/videos/:id",
      "destination": "/api/videos?id=:id"
    },
    {
      "source": "/api/news/:slug",
      "destination": "/api/articles?slug=:slug"
    },
    {
      "source": "/api/news",
      "destination": "/api/articles?news=1"
    },
    {
      "source": "/api/articles/:slug/comments/:commentId/like",
      "destination": "/api/articles?slug=:slug&action=like_comment&commentId=:commentId"
    },
    {
      "source": "/api/articles/:slug/comments/:commentId",
      "destination": "/api/articles?slug=:slug&action=delete_comment&commentId=:commentId"
    },
    {
      "source": "/api/articles/:slug/comments",
      "destination": "/api/articles?slug=:slug&action=comments"
    },
    {
      "source": "/api/articles/:slug/view",
      "destination": "/api/articles?slug=:slug&action=view"
    },
    {
      "source": "/api/articles/:slug",
      "destination": "/api/articles?slug=:slug"
    },
    {
      "source": "/api/publisher/onboarding",
      "destination": "/api/publishers"
    },
    {
      "source": "/api/publishers/:id",
      "destination": "/api/publishers?id=:id"
    },
    {
      "source": "/api/admin/articles/:id",
      "destination": "/api/admin/articles?id=:id"
    },
    {
      "source": "/api/admin/publishers/:id",
      "destination": "/api/admin/publishers?id=:id"
    },
    {
      "source": "/",
      "destination": "/api/render"
    },
    {
      "source": "/videos",
      "destination": "/api/render"
    },
    {
      "source": "/videos/:slug*",
      "destination": "/api/render"
    },
    {
      "source": "/articles",
      "destination": "/api/render"
    },
    {
      "source": "/articles/:slug*",
      "destination": "/api/render"
    },
    {
      "source": "/news",
      "destination": "/api/render"
    },
    {
      "source": "/news/:slug*",
      "destination": "/api/render"
    },
    {
      "source": "/category/:id*",
      "destination": "/api/render"
    },
    {
      "source": "/professionals/:id*",
      "destination": "/api/render"
    },
    {
      "source": "/publishers/:id*",
      "destination": "/api/render"
    },
    {
      "source": "/calculator",
      "destination": "/api/render"
    },
    {
      "source": "/quiz",
      "destination": "/api/render"
    },
    {
      "source": "/login",
      "destination": "/api/render"
    },
    {
      "source": "/signup",
      "destination": "/api/render"
    },
    {
      "source": "/profile",
      "destination": "/api/render"
    },
    {
      "source": "/history",
      "destination": "/api/render"
    },
    {
      "source": "/admin",
      "destination": "/api/render"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/render"
    }
  ]
}

