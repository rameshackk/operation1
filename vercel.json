{
  "version": 2,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/fetch-videos",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/videos/:id",
      "destination": "/api/videos/[id]"
    },
    {
      "source": "/api/articles/:slug",
      "destination": "/api/articles/[slug]"
    },
    {
      "source": "/api/admin/articles/:id",
      "destination": "/api/admin/articles/[id]"
    }
  ]
}
