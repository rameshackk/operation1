# ============================================================
# DHANAVRIKSHA WEALTH - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# 1. Supabase Project Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# 2. Postgres Connection Pooling String (Port 6543 - REQUIRED for Vercel Serverless Functions)
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> Connection Pooler (Port 6543)
# Example: postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_REF]:YOUR_PASSWORD@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# 3. YouTube Data API v3 (Google Cloud Console -> Enable "YouTube Data API v3" -> Credentials -> API Key)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY
YOUTUBE_CHANNEL_ID=UCWD5lYsFycgIDyCB_EHpYOQ

# 4. Google Cloud Translation v2 REST API Key (Google Cloud Console -> Enable "Cloud Translation API" -> API Key)
TRANSLATE_API_KEY=YOUR_GOOGLE_TRANSLATE_API_KEY

# 5. Ingestion Cron Secret (Bearer Authorization header check)
CRON_SECRET=super_secret_cron_bearer_token_123

# 6. Brand Configuration (Used for translation protected-term masking)
COMPANY_NAME=Dhanavriksha Wealth
CHANNEL_NAME=Budget Padmanaban
